// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init// prisma/schema.prisma
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum StatusVote {
    PENDING
    SUBMITTED
}

enum StatusCard {
    DRAFT
    WAITING_RESPONSE
    NEED_ACTION
    COMPLETED
}

enum StatusNotification {
    UNREAD
    READ
}

enum TypeNotification {
    INVITE
    REMINDER
    RESPONSE
    DELETE
    CREATE
    UPDATE
}

model User {
    id      String  @id @default(uuid())
    appleId String @unique
    email   String?
    events  Event[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
    
    @@map("users")
}

model Event {
    id        String     @id @default(uuid())
    title     String?    @unique
    location  String?
    notes     String?
    startDate DateTime?
    endDate   DateTime?
    allDay    Boolean    @default(false)
    status    StatusCard @default(DRAFT)

    proposedTimes DateTime[]
    matchedTimes  DateTime[]
    selectedTime  DateTime?

    participants  Participant[]
    notifications Notification[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@map("events")
}

model Participant {
    id     String     @id @default(uuid())
    name   String
    email  String?
    status StatusVote @default(PENDING)

    selectedTimes DateTime[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
    eventId String

    @@map("participants")
}

model Notification {
    id        String             @id @default(uuid())
    type      TypeNotification
    message   String
    status    StatusNotification @default(UNREAD)
    createdAt DateTime           @default(now())
    deletedAt DateTime?

    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
    eventId String

    @@map("notifications")
}
